# Copy to .env.local. Next.js reads env files from apps/web only, not the repo root.

# Server-side rewrites in next.config.js
API_GATEWAY_URL=http://localhost:8000
ADMIN_SERVICE_URL=http://localhost:8087

# Browser-side admin calls (lib/admin-api.ts)
NEXT_PUBLIC_ADMIN_SERVICE_URL=http://localhost:8087

# Calls the real API Gateway; set to true to use mock data instead
NEXT_PUBLIC_USE_MOCKS=false
