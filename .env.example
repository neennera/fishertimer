# ==============================================================================
# Fisher Timer - Global Environment Variables Template (.env.example)
# Copy this file to .env for local development:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Server Ports
# ------------------------------------------------------------------------------
NODE_ENV=development
ENV=development

# Microservices HTTP Port Allocations
API_GATEWAY_PORT=8000
ACCOUNT_SERVICE_PORT=8082
SESSION_SERVICE_PORT=8083
TIMER_SERVICE_PORT=8084
REWARD_SERVICE_PORT=8085
LEADERBOARD_SERVICE_PORT=8086
ADMIN_SERVICE_PORT=8087
WEB_PORT=3000

# Microservices gRPC Port Allocations
TIMER_GRPC_PORT=50051
SESSION_GRPC_PORT=50052

# Microservice Target URLs (HTTP & gRPC)
API_GATEWAY_URL=http://localhost:8000
ACCOUNT_SERVICE_URL=http://localhost:8082
SESSION_SERVICE_URL=http://localhost:8083
SESSION_GRPC_TARGET=localhost:50052
TIMER_SERVICE_URL=http://localhost:8084
TIMER_GRPC_TARGET=localhost:50051
REWARD_SERVICE_URL=http://localhost:8085
LEADERBOARD_SERVICE_URL=http://localhost:8086
ADMIN_SERVICE_URL=http://localhost:8087

# ------------------------------------------------------------------------------
# 2. Database Connection Strings (Database per Service - 3NF)
# ------------------------------------------------------------------------------
ACCOUNT_DATABASE_URL=postgres://postgres:postgrespassword@localhost:5432/account_db?sslmode=disable
SESSION_DATABASE_URL=postgres://postgres:postgrespassword@localhost:5433/session_db?sslmode=disable
TIMER_DATABASE_URL=postgres://postgres:postgrespassword@localhost:5434/timer_db?sslmode=disable
ADMIN_DATABASE_URL=postgres://postgres:postgrespassword@localhost:5435/admin_db?sslmode=disable

# Document Database (MongoDB)
REWARD_MONGODB_URI=mongodb://mongoadmin:mongopassword@localhost:27017/reward_db?authSource=admin

# In-Memory Cache (Redis)
LEADERBOARD_REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# 3. Authentication & Security
# ------------------------------------------------------------------------------
# Google OAuth 2.0 Credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google

# JWT Configuration (managed in Account Service)
JWT_SECRET=super-secret-fisher-timer-jwt-key-change-in-production-min32chars
JWT_EXPIRATION_HOURS=24
JWT_ISSUER=fishertimer-account

# ------------------------------------------------------------------------------
# 4. Frontend Public Variables (Next.js)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Fisher Timer"
NEXT_PUBLIC_API_GATEWAY_URL=http://localhost:8000
NEXT_PUBLIC_ADMIN_SERVICE_URL=http://localhost:8087
