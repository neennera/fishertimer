# ==============================================================================
# Fisher Timer - Global Environment Variables Template (.env.example)
# Copy this file to .env for local development:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Server Ports
# ------------------------------------------------------------------------------
NODE_ENV=development
ENV=development

# Microservices Port Allocations
AUTH_SERVICE_PORT=8081
ACCOUNT_SERVICE_PORT=8082
SESSION_SERVICE_PORT=8083
TIMER_SERVICE_PORT=8084
REWARD_SERVICE_PORT=8085
LEADERBOARD_SERVICE_PORT=8086
ADMIN_SERVICE_PORT=8087
WEB_PORT=3000

# Microservice Target URLs (Used by Next.js API Gateway Rewrites)
AUTH_SERVICE_URL=http://localhost:8081
ACCOUNT_SERVICE_URL=http://localhost:8082
SESSION_SERVICE_URL=http://localhost:8083
TIMER_SERVICE_URL=http://localhost:8084
REWARD_SERVICE_URL=http://localhost:8085
LEADERBOARD_SERVICE_URL=http://localhost:8086
ADMIN_SERVICE_URL=http://localhost:8087

# ------------------------------------------------------------------------------
# 2. Database Connection Strings
# ------------------------------------------------------------------------------
# Local PostgreSQL (from docker-compose.yml) or Supabase Cloud
DATABASE_URL=postgres://postgres:postgrespassword@localhost:5432/fishertimer?sslmode=disable
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=fishertimer

# Local MongoDB (from docker-compose.yml) or MongoDB Atlas
MONGODB_URI=mongodb://mongoadmin:mongopassword@localhost:27017/fishertimer?authSource=admin
MONGO_INITDB_ROOT_USERNAME=mongoadmin
MONGO_INITDB_ROOT_PASSWORD=mongopassword
MONGO_INITDB_DATABASE=fishertimer

# ------------------------------------------------------------------------------
# 3. Authentication & Security (ADR-005)
# ------------------------------------------------------------------------------
# Google OAuth 2.0 Credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google

# JWT Configuration
JWT_SECRET=super-secret-fisher-timer-jwt-key-change-in-production-min32chars
JWT_EXPIRATION_HOURS=24
JWT_ISSUER=fishertimer-auth

# ------------------------------------------------------------------------------
# 4. Frontend Public Variables (Next.js)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Fisher Timer"
