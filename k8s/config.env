# Non-secret settings shared by every service (the cluster's version of .env).
# Kustomize turns this file into the ConfigMap `fishertimer-config`.
#
# Addresses use Service names, not localhost: inside the cluster each database
# and service gets its own DNS name, so all of them keep their default port.
#
# Never add PORT here: every service reads PORT before its own *_SERVICE_PORT,
# so a shared PORT would make all of them listen on the same port.

# "production" makes the account service mark cookies Secure (HTTPS only).
# The local cluster serves plain http://fishertimer.localhost, so login would break.
ENV=development
NODE_ENV=production

# HTTP ports
API_GATEWAY_PORT=8000
ACCOUNT_SERVICE_PORT=8082
SESSION_SERVICE_PORT=8083
TIMER_SERVICE_PORT=8084
REWARD_SERVICE_PORT=8085
LEADERBOARD_SERVICE_PORT=8086
ADMIN_SERVICE_PORT=8087

# gRPC ports
TIMER_GRPC_PORT=50051
SESSION_GRPC_PORT=50052

# Service addresses (Service name:port)
ACCOUNT_SERVICE_URL=http://account:8082
SESSION_SERVICE_URL=http://study-session:8083
SESSION_GRPC_TARGET=study-session:50052
TIMER_SERVICE_URL=http://study-timer:8084
TIMER_GRPC_TARGET=study-timer:50051
REWARD_SERVICE_URL=http://reward:8085
LEADERBOARD_SERVICE_URL=http://leaderboard:8086
ADMIN_SERVICE_URL=http://admin:8087

# Redis has no password locally, so its URL is not a secret.
LEADERBOARD_REDIS_URL=redis://redis:6379

# Study Session automatic removals (0 turns a rule off)
SESSION_MAX_AGE_HOURS=24
SESSION_DISCONNECT_TIMEOUT_SECONDS=120
IDLE_TIMEOUT_MINUTES=10

# Study Timer limits
MIN_WORK_MINUTES=1
MAX_WORK_MINUTES=120
MIN_REST_MINUTES=1
MAX_REST_MINUTES=60
MAX_PAUSE_MINUTES=15
TIMER_SWEEP_INTERVAL_SECONDS=2

# Auth (non-secret parts)
JWT_EXPIRATION_HOURS=168
JWT_ISSUER=fishertimer-account
GOOGLE_REDIRECT_URI=http://fishertimer.localhost/api/auth/google/callback
CORS_ALLOWED_ORIGINS=http://fishertimer.localhost
NEXT_PUBLIC_APP_URL=http://fishertimer.localhost
