# Template for k8s/secrets.env (git-ignored). Kustomize turns it into the
# Secret `fishertimer-secrets`.
#   cp k8s/secrets.env.example k8s/secrets.env   # then fill in real values
#
# The connection URLs hold passwords, so they live here, not in config.env.
# Each password must match the one in its URL.

# Databases (the DB containers read the *_PASSWORD values on first start)
POSTGRES_PASSWORD=change-me
ACCOUNT_DATABASE_URL=postgres://postgres:change-me@account-db:5432/account_db?sslmode=disable
SESSION_DATABASE_URL=postgres://postgres:change-me@session-db:5432/session_db?sslmode=disable
TIMER_DATABASE_URL=postgres://postgres:change-me@timer-db:5432/timer_db?sslmode=disable
ADMIN_DATABASE_URL=postgres://postgres:change-me@admin-db:5432/admin_db?sslmode=disable

MONGO_PASSWORD=change-me
REWARD_MONGODB_URI=mongodb://mongoadmin:change-me@reward-db:27017/reward_db?authSource=admin

RABBITMQ_PASSWORD=change-me
RABBITMQ_URL=amqp://admin:change-me@rabbitmq:5672/

# Auth: at least 32 characters
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Google OAuth (Google Cloud Console). Add the redirect URI from config.env there.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
