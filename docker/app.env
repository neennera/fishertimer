# Settings for running the whole stack with Docker Compose
# (docker compose --profile app up). Committed on purpose: every value here is a
# local-development default that matches the credentials in docker-compose.yml.
#
# Layering, later files win (see env_file in docker-compose.yml):
#   1. k8s/config.env  shared ports, service addresses (Docker DNS names), limits
#   2. docker/app.env  this file: Compose-specific overrides + DB/broker URLs
#   3. .env.docker     your own secrets (git-ignored, optional): cp .env.docker.example .env.docker
#
# Never add PORT here: every service reads PORT before its own *_SERVICE_PORT.

# The web app is published on http://localhost:3000, so OAuth and CORS use it.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
CORS_ALLOWED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Databases (hosts are the Compose service names, ports are the container ports)
ACCOUNT_DATABASE_URL=postgres://postgres:postgrespassword@account-db:5432/account_db?sslmode=disable
SESSION_DATABASE_URL=postgres://postgres:postgrespassword@session-db:5432/session_db?sslmode=disable
TIMER_DATABASE_URL=postgres://postgres:postgrespassword@timer-db:5432/timer_db?sslmode=disable
ADMIN_DATABASE_URL=postgres://postgres:postgrespassword@admin-db:5432/admin_db?sslmode=disable
REWARD_MONGODB_URI=mongodb://mongoadmin:mongopassword@reward-db:27017/reward_db?authSource=admin

# Message broker
RABBITMQ_URL=amqp://admin:adminpassword@rabbitmq:5672/

# Auth: development-only secret (min 32 chars). Override it in .env.docker.
JWT_SECRET=dev-only-fishertimer-jwt-secret-change-me-32chars
