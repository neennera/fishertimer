# Your own settings for `docker compose --profile app up` (git-ignored once copied):
#   cp .env.docker.example .env.docker
# Overrides docker/app.env and k8s/config.env. Everything is optional except the
# Google credentials, which sign-in needs.

# Google OAuth (Google Cloud Console). Add this redirect URI to the OAuth client:
#   http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Optional: replace the development JWT secret (at least 32 characters)
# JWT_SECRET=

# ---------------------------------------------------------------------------
# Hybrid mode: run one service on your machine, the rest in Docker.
# Example, developing `reward` with `go run` while everything else is in Docker:
#
#   1. Start the stack without that service, with the debugging ports on:
#        docker compose -f docker-compose.yml -f docker-compose.dev.yml \
#          --profile app up -d --scale reward=0
#   2. Point the containers that call it at your machine (uncomment):
#        REWARD_SERVICE_URL=http://host.docker.internal:8085
#   3. Run it on the host against the published ports (the repo's .env already
#      holds the localhost addresses): cd services/reward && go run ./cmd
#
# gRPC services use host:port targets instead, e.g.
#   TIMER_GRPC_TARGET=host.docker.internal:50051
#   SESSION_GRPC_TARGET=host.docker.internal:50052
# ---------------------------------------------------------------------------
